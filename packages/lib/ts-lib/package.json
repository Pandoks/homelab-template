  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@homelab-template/postgres": "workspace:^",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/webauthn": "^1.0.0",
    "drizzle-orm": "^0.36.4",
    "redis": "^4.6.15"
  },
  "devDependencies": {
    "postgres": "^3.4.5",
    "vitest": "^2.1.5"
  }
}
