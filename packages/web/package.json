{
  "name": "@homelab-template/web",
  "version": "0.0.0",
  "files": [
    "build"
  ],
  "scripts": {
    "setup": "pnpm run reset && docker compose -f ../../setup-compose.yaml -p setup up -d",
    "reset": "docker compose -p setup down",
    "dev": "pnpm run setup && dotenv -e ../../.env -- vite dev",
    "build": "vite build",
    "test:unit": "pnpm run setup && vitest",
    "test:int": "if [ -z \"$CI\" ]; then dotenv -e ../../.env -- playwright test; else playwright test; fi",
    "test:gen": "dotenv -e ../../.env -- playwright codegen",
    "test:ui": "dotenv -e ../../.env -- playwright test --ui",
    "lint": "svelte-check",
    "format": "prettier --write .",
    "prepare": "svelte-kit sync || echo ''",
    "k3d:tag": "docker tag homelab-web:latest localhost:12345/homelab-web:latest",
    "k3d:push": "pnpm run k3d:tag && docker push localhost:12345/homelab-web:latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.17.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.7",
    "@types/node": "^22.13.5",
    "autoprefixer": "^10.4.19",
    "bits-ui": "1.3.4",
    "dotenv-cli": "^8.0.0",
    "formsnap": "2.0.0",
    "lucide-svelte": "^0.475.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "prettier-plugin-svelte": "^3.3.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "svelte": "^5.20.4",
    "svelte-check": "^4.1.4",
    "sveltekit-superforms": "^2.23.1",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  },
  "type": "module",
  "dependencies": {
    "@homelab-template/postgres": "workspace:^",
    "@homelab-template/ts-lib": "workspace:^",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@oslojs/webauthn": "^1.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "postgres": "^3.4.5",
    "redis": "^4.6.15",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.3.1",
    "uqr": "^0.1.2"
  }
}
