{
  "name": "@homelab-template/postgres",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "maindb:gen": "drizzle-kit generate --config ./main/drizzle/drizzle.config.ts --name init && rm -rf ./main/setup/meta",
    "maindb:push": "drizzle-kit push --config ./main/drizzle/drizzle.config.ts",
    "maindb:studio": "drizzle-kit studio --config ./main/drizzle/drizzle.config.ts",
    "k3d:tag": "REGISTRY_URL=localhost:12345 docker compose --profile build-for-prod -f ./images/compose.yaml build",
    "k3d:push": "pnpm run k3d:tag && REGISTRY_URL=localhost:12345 docker compose --profile build-for-prod -f ./images/compose.yaml push",
    "reset": "rm -rf ../../.docker-volumes/postgres/ && docker compose -f ./images/compose.yaml down",
    "up": "pnpm run reset && docker compose -f ./images/compose.yaml up"
  },
  "exports": {
    "./main/*": "./main/drizzle/schema/*.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "sst": "^3.9.10"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4"
  }
}
