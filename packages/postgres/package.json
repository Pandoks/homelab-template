{
  "name": "@homelab-template/postgres",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "db:reset": "pnpm run maindb:reset",
    "maindb:reset": "rm -rf ./main/setup/meta ./main/setup/0001_init.sql",
    "maindb:gen": "pnpm run maindb:reset && drizzle-kit generate --config ./main/drizzle/drizzle.config.ts --name init",
    "maindb:studio": "drizzle-kit studio --config ./main/drizzle/drizzle.config.ts"
  },
  "exports": {
    "./main/*": "./main/drizzle/schema/*.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "sst": "^3.3.27"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4"
  }
}
